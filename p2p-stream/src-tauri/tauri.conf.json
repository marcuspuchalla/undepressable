{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "P2P Emergency Stream",
  "version": "0.1.0",
  "identifier": "com.p2pstream.emergency",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4400",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "P2P Emergency Stream",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": [],
    "copyright": "",
    "category": "SocialNetworking",
    "shortDescription": "Censorship-resistant P2P live streaming",
    "longDescription": "P2P Emergency Stream enables censorship-resistant live streaming with multi-device recording for evidence preservation.",
    "macOS": {
      "entitlements": "./entitlements.plist",
      "exceptionDomain": "*",
      "dmg": {
        "windowSize": {
          "width": 800,
          "height": 600
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 520,
          "y": 170
        }
      }
    }
  }
}
