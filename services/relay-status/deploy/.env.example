# --- host ---
PUBLIC_IP=152.53.160.100
PROXY_NETWORK=coolify
STATUS_HOST=relay-status.example.org
TURN_HOST=turn.example.org
RELAY_MIN_PORT=49152
RELAY_MAX_PORT=65535

# --- relay-status ---
ADMIN_TOKEN=change-me
POLL_SECONDS=60

# Our own relay: 20 GB a month
FMP_LABEL=Undepressable relay
FMP_URLS=turn:turn.example.org:3478,turns:turn.example.org:443?transport=tcp
FMP_REALM=undepressable
FMP_USERNAME=undepressable
FMP_PASSWORD=change-me
FMP_LIMIT_GB=20

# ExpressTURN (free plan, port 3478 only): dashboard credentials. No usage API —
# enter the dashboard figure with POST /v1/admin/usage.
ET_URLS=turn:free.expressturn.com:3478
ET_USERNAME=
ET_PASSWORD=
ET_LIMIT_GB=900

# Cloudflare Realtime TURN: handed out by the app's "Check" button only.
# CF_ANALYTICS_TOKEN needs the "Account Analytics: Read" permission.
CF_ACCOUNT_ID=
CF_ANALYTICS_TOKEN=
CF_TURN_KEY_ID=
CF_TURN_KEY_TOKEN=
CF_LIMIT_GB=900
CF_CREDENTIAL_TTL_HOURS=6
